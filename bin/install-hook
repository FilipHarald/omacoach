#!/bin/bash

set -euo pipefail

PLUGIN_ID="omacoach"
START_MARKER="-- omacoach:start"
END_MARKER="-- omacoach:end"
BINDINGS_FILE="$HOME/.config/hypr/bindings.lua"
PLUGIN_DIR="$HOME/.config/omarchy/plugins/$PLUGIN_ID"
OBSERVER_FILE="$PLUGIN_DIR/hypr/observer.lua"
OMARCHY_ROOT="${OMARCHY_PATH:-/usr/share/omarchy}"

fail() {
  printf 'install-hook: %s\n' "$*" >&2
  exit 1
}

command -v omarchy-shell >/dev/null 2>&1 || fail "Omarchy Quattro is required; no configuration was changed"
command -v omarchy-plugin-validate >/dev/null 2>&1 || fail "Omarchy plugin validation is unavailable; no configuration was changed"
command -v hyprctl >/dev/null 2>&1 || fail "hyprctl is required; no configuration was changed"
command -v luac >/dev/null 2>&1 || fail "luac is required; no configuration was changed"
[[ -f "$OMARCHY_ROOT/shell/services/PluginRegistry.qml" ]] || fail "Omarchy Quattro is required; no configuration was changed"
[[ -f "$PLUGIN_DIR/manifest.json" && -f "$OBSERVER_FILE" ]] || fail "plugin is not installed at $PLUGIN_DIR; no configuration was changed"
[[ -f "$BINDINGS_FILE" ]] || fail "$BINDINGS_FILE does not exist; no configuration was changed"

PLUGIN_SOURCE=$(readlink -f "$PLUGIN_DIR")
omarchy-plugin-validate "$PLUGIN_SOURCE" >/dev/null || fail "plugin validation failed; no configuration was changed"
luac -p "$OBSERVER_FILE" "$PLUGIN_DIR/hypr/ObserverState.lua" || fail "plugin Lua validation failed; no configuration was changed"

probe=$(hyprctl repl 'return type(hl.on), type(hl.timer), type(hl.is_key_down), type(hl.get_active_monitor)' 2>/dev/null) ||
  fail "could not query Hyprland Lua; no configuration was changed"
[[ "$probe" == $'function\tfunction\tfunction\tfunction' ]] || fail "Hyprland lacks required Lua APIs; no configuration was changed"

start_count=$(grep -Fxc -- "$START_MARKER" "$BINDINGS_FILE" || true)
end_count=$(grep -Fxc -- "$END_MARKER" "$BINDINGS_FILE" || true)
if ((start_count == 1 && end_count == 1)); then
  printf 'Omacoach observer is already installed.\n'
  exit 0
fi
if ((start_count != 0 || end_count != 0)); then
  fail "found an incomplete Omacoach marker block; no configuration was changed"
fi

timestamp=$(date -u +%Y%m%d%H%M%S)
backup="$BINDINGS_FILE.omacoach.bak.$timestamp"
temp_file=$(mktemp "$BINDINGS_FILE.omacoach.XXXXXX")
changed=0

cleanup() {
  status=$?
  rm -f -- "$temp_file"
  if ((status != 0 && changed == 1)); then
    cp -p -- "$backup" "$BINDINGS_FILE"
    hyprctl reload >/dev/null 2>&1 || true
    printf 'install-hook: restored %s after installation failure\n' "$BINDINGS_FILE" >&2
  fi
  exit "$status"
}
trap cleanup EXIT

cp -p -- "$BINDINGS_FILE" "$backup"
cp -p -- "$BINDINGS_FILE" "$temp_file"

cat >>"$temp_file" <<'LUA'

-- omacoach:start
do
  local home = os.getenv("HOME")
  local path = home and (home .. "/.config/omarchy/plugins/omacoach/hypr/observer.lua")
  if path then
    local file = io.open(path, "r")
    if file then
      file:close()
      local ok, err = pcall(dofile, path)
      if not ok then io.stderr:write("omacoach: " .. tostring(err) .. "\n") end
    end
  end
end
-- omacoach:end
LUA

chmod --reference="$BINDINGS_FILE" "$temp_file"
luac -p "$temp_file" || fail "generated bindings.lua is invalid"
mv -- "$temp_file" "$BINDINGS_FILE"
changed=1

hyprctl reload >/dev/null || fail "Hyprland reload failed"
config_errors=$(hyprctl configerrors 2>/dev/null || true)
[[ -z "$config_errors" ]] || fail "Hyprland reported configuration errors: $config_errors"

changed=0
trap - EXIT
printf 'Installed Omacoach observer. Backup: %s\n' "$backup"
