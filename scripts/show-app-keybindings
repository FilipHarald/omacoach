#!/usr/bin/env node

const path = require("node:path")
const { execFileSync } = require("node:child_process")

const desktopId = String(process.argv[2] || "").trim()
const name = String(process.argv[3] || desktopId).trim()
if (!desktopId) {
  console.error("Usage: show-app-keybindings <desktop-id> [name]")
  process.exit(1)
}

const matcher = path.join(__dirname, "match-searched-app-bindings")
const results = JSON.parse(execFileSync(matcher, ["--json"], { encoding: "utf8" }))
const app = results.find(result => String(result.desktopId) === desktopId)
const matches = app && Array.isArray(app.matches) ? app.matches : []
if (matches.length === 0) process.exit(1)

const options = matches.map(match => String(match.shortcut) + " -> " + String(match.description))
try {
  execFileSync("omarchy-menu-select", ["Keybindings - " + name, ...options, "--", "--width", "800", "--height", "500"], {
    stdio: "ignore"
  })
} catch (_) {
  // Cancelling the selector is expected.
}
