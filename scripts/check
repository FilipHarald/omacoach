#!/bin/bash

set -euo pipefail

test -x bin/toggle-panel
node tests/model.js
lua tests/observer.lua
keymap_output=$(scripts/keymap)
grep -q $'65\tSPACE' <<<"$keymap_output"
luac -p hypr/observer.lua hypr/ObserverState.lua
omarchy-plugin-validate .
qmllint -I /usr/share/omarchy/shell ShortcutOverlay.qml components/*.qml
